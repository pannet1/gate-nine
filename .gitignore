# Secrets and local configuration
.env
.env.*
!.env.example

# Saved Playwright authentication state — holds session cookies for the tenant
auth.json

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# Local databases and runtime data
*.sqlite3
*.db
data/
logs/

# Run-local evidence that may contain tenant or customer data
*.png
*.jpg
*.jpeg
*.pdf
screenshots/

# Event logs stream to the remote endpoint and are not kept locally
test-cases/*/events.jsonl

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
*.swp

# Build and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# One auth.json per system, linked into each case folder at tidy time — never committed
recordings/*/auth.json
